PROJECT_NAME="AI Interviewer Platform"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# CORS Configuration
# Provide a comma-separated list of allowed origins (e.g. "http://localhost:3000,https://myproductionapp.com")
ALLOWED_ORIGINS="http://localhost:3000"

# Security
SECRET_KEY="replace_me_with_a_secure_random_string_in_production"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# Note: When using docker-compose, POSTGRES_SERVER is dynamically set to "db"
POSTGRES_SERVER="localhost"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="password"
POSTGRES_DB="ai_interviewer"
POSTGRES_PORT=5432
DATABASE_URI="postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_SERVER}:${POSTGRES_PORT}/${POSTGRES_DB}"

# Redis / Celery
# Note: When using docker-compose, REDIS_URL is dynamically set to "redis://redis:6379/0"
REDIS_URL="redis://localhost:6379/0"

# AI Providers
OPENAI_API_KEY=""
